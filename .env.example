# ============================================================================
# MERIDIAN — Environment Configuration
# Copy to .env and edit. Every setting is optional; the app boots with zero
# configuration using SQLite and the local analytical engine.
# Developed by Mridul Sharma
# ============================================================================

# --- Server -----------------------------------------------------------------
# Render/Railway/Fly inject PORT at runtime (Render = 10000) and REQUIRE the
# app to bind 0.0.0.0:$PORT. Never hardcode 8000 in a cloud start command.
# Locally PORT is optional; python run.py / docker-entrypoint.sh default to 8000.
MERIDIAN_HOST=0.0.0.0
MERIDIAN_PORT=8000
# PORT=10000             # uncomment only if your host does not inject it
# MUST stay 1 on PaaS: report jobs and SSE events live in process memory.
WEB_CONCURRENCY=1
MERIDIAN_DEBUG=false
# Startup warm-up (schema + demo report) runs AFTER the port is listening.
MERIDIAN_BACKGROUND_BOOTSTRAP=true

# --- Optional free-tier keep-alive ------------------------------------------
# Defence in depth ONLY while the process is alive. It CANNOT wake a spun-down
# Render Free service — use UptimeRobot or the GitHub Actions template.
# Set to your PUBLIC URL after the first deploy (https://your-app.onrender.com).
# MERIDIAN_SELF_PING_URL=
# MERIDIAN_SELF_PING_INTERVAL=600

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for a zero-config SQLite file at data/meridian.db.
# ⚠️ On Render/Railway/Fly the filesystem is EPHEMERAL: reports, exports and
# keys are erased on every restart, deploy and Free spin-down. Always set a
# managed PostgreSQL URL in production (psycopg2-binary is installed).
# DATABASE_URL=postgresql+psycopg2://meridian:meridian@localhost:5432/meridian
# Optional Redis cache — a missing/broken cache never breaks a request.
# REDIS_URL=redis://localhost:6379/0

# --- Encryption -------------------------------------------------------------
# IMPORTANT: set a stable secret in production. If omitted, Meridian generates
# one at data/.fernet_key (mode 0600, never committed) — which is wiped on an
# ephemeral disk, making previously saved API keys undecryptable.
# A valid Fernet key is used verbatim; any other opaque secret (e.g. Render's
# generateValue) is hashed into a valid key, so either form is safe.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MERIDIAN_FERNET_KEY=your-base64-fernet-key-or-any-random-secret
# MERIDIAN_FERNET_KEY_FILE=/run/secrets/meridian_fernet_key

# --- Live data connectors (all optional) ------------------------------------
# Without these, Meridian uses a deterministic, clearly-labelled local engine.
TAVILY_API_KEY=
NEWS_API_KEY=
MERIDIAN_LIVE_DATA=true
MERIDIAN_USE_YFINANCE=false
MERIDIAN_WORLD_BANK=true
MERIDIAN_HTTP_TIMEOUT=8
MERIDIAN_MAX_SOURCES=12

# --- Agent behaviour --------------------------------------------------------
MERIDIAN_DEMO_MODE=true
MERIDIAN_MAX_WORKERS=6
MERIDIAN_AGENT_TIMEOUT=45

# --- Storage ----------------------------------------------------------------
MERIDIAN_DATA_DIR=./data
MERIDIAN_EXPORT_DIR=./data/exports

# --- Optional upstream defaults (per-agent keys are entered in Settings) ----
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
